// Prisma Schema for Money Management App
// Database: PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Authentication Models (NextAuth)
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts            Account[]
  sessions            Session[]
  financialAccounts   FinancialAccount[]
  transactions        Transaction[]
  budgets             Budget[]
  categories          Category[]
  parties             Party[]
  goals               Goal[]
  watchlists          Watchlist[]
  recurringTransactions RecurringTransaction[]
  notifications       Notification[]
  chatMessages        ChatMessage[]
  insights            Insight[]
  settings            UserSettings?
  templates           TransactionTemplate[]
  settlements         Settlement[]
  settlementGroupsCreated            SettlementGroup[]           @relation("SettlementGroupCreator")
  settlementGroupMemberships         SettlementGroupMember[]
  settlementGroupInvitationsSent     SettlementGroupInvitation[] @relation("SettlementInvitationSender")
  settlementGroupInvitationsReceived SettlementGroupInvitation[] @relation("SettlementInvitationReceiver")
  settlementGroupTransactionsCreated SettlementGroupTransaction[] @relation("SettlementTransactionCreator")
  settlementGroupTransactionsPaid    SettlementGroupTransaction[] @relation("SettlementTransactionPayer")
  receipts            Receipt[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// User Settings
// ============================================

model UserSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  currency          String   @default("INR")
  currencySymbol    String   @default("₹")
  dateFormat        String   @default("MM/DD/YYYY")
  language          String   @default("en")
  darkMode          Boolean  @default(false)

  // Notifications
  notificationsEnabled          Boolean @default(true)
  budgetAlertsEnabled           Boolean @default(true)
  billRemindersEnabled          Boolean @default(true)
  goalMilestonesEnabled         Boolean @default(true)
  recurringTransactionsEnabled  Boolean @default(true)

  // Privacy
  requireAuth       Boolean  @default(false)
  autoLockMinutes   Int      @default(15)

  // Display
  showCents         Boolean  @default(true)
  compactMode       Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ============================================
// Financial Models
// ============================================

model FinancialAccount {
  id          String   @id @default(cuid())
  userId      String
  name        String
  balance     Float    @default(0)
  type        String   // "checking" | "savings" | "credit"
  color       String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  goals                 Goal[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
  @@map("financial_accounts")
}

model Transaction {
  id              String   @id @default(cuid())
  userId          String
  accountId       String
  description     String
  amount          Float
  date            DateTime
  category        String
  type            String   // "income" | "expense"
  party           String?
  notes           String?  @db.Text
  tags            String[] @default([])
  recurringId     String?
  isShared        Boolean  @default(false)
  splits          Json?
  totalAmount     Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account             FinancialAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([accountId])
  @@index([date])
  @@index([category])
  @@index([type])
  @@map("transactions")
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   // "income" | "expense" | "both"
  color     String?
  icon      String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subBudgets SubBudget[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Party {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("parties")
}

// ============================================
// Budgets
// ============================================

model Budget {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           String      // "monthly" | "event" | "trip"
  method         String      @default("envelope") // "envelope" | "fixed_cap" | "goal_linked"
  periodType     String      @default("monthly") // "monthly" | "custom" | "rolling"
  totalAllocated Float
  totalSpent     Float       @default(0)
  warningThreshold Float     @default(80)
  criticalThreshold Float    @default(100)
  alertWindowDays Int        @default(5)
  enforcementMode String     @default("soft") // "soft" | "hard"
  presetKey      String?
  goalId         String?
  startDate      DateTime?
  endDate        DateTime?
  rollover       Boolean     @default(false)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal       Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  subBudgets SubBudget[]

  @@index([userId])
  @@index([goalId])
  @@map("budgets")
}

model SubBudget {
  id             String   @id @default(cuid())
  budgetId       String
  categoryId     String?
  category       String
  allocated      Float
  spent          Float    @default(0)
  alertThreshold Float?   @default(80)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryRef Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([budgetId])
  @@index([categoryId])
  @@index([budgetId, category])
  @@map("sub_budgets")
}

// ============================================
// Goals
// ============================================

model Goal {
  id                   String   @id @default(cuid())
  userId               String
  name                 String
  targetAmount         Float
  currentAmount        Float    @default(0)
  targetDate           DateTime?
  monthlyContribution  Float?
  priority             String   @default("medium") // "low" | "medium" | "high"
  color                String?
  icon                 String?
  accountId            String?
  includeInSpendingPlan Boolean @default(true)
  notes                String?  @db.Text
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  linkedBudgets Budget[]

  @@index([userId])
  @@map("goals")
}

// ============================================
// Watchlists
// ============================================

model Watchlist {
  id             String    @id @default(cuid())
  userId         String
  name           String
  type           String    // "category" | "tag" | "payee"
  value          String
  budgetLimit    Float?
  period         String    @default("monthly") // "monthly" | "yearly" | "custom"
  startDate      DateTime?
  endDate        DateTime?
  alertEnabled   Boolean   @default(true)
  alertThreshold Float?    @default(80)
  color          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("watchlists")
}

// ============================================
// Recurring Transactions
// ============================================

model RecurringTransaction {
  id           String   @id @default(cuid())
  userId       String
  accountId    String
  description  String
  amount       Float
  category     String
  type         String   // "income" | "expense"
  frequency    String   // "daily" | "weekly" | "biweekly" | "monthly" | "quarterly" | "yearly"
  startDate    DateTime
  endDate      DateTime?
  nextDueDate  DateTime
  isActive     Boolean  @default(true)
  autoCreate   Boolean  @default(false)
  reminderDays Int?     @default(3)
  notes        String?  @db.Text
  tags         String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([nextDueDate])
  @@map("recurring_transactions")
}

// ============================================
// Notifications
// ============================================

model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String   // "budget" | "bill" | "goal" | "recurring" | "info" | "warning"
  title      String
  message    String   @db.Text
  timestamp  DateTime @default(now())
  isRead     Boolean  @default(false)
  actionLink String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ============================================
// AI Chatbot & Insights
// ============================================

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   // "user" | "assistant"
  content   String   @db.Text
  metadata  Json?    // Store additional context like charts, insights referenced
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("chat_messages")
}

model Insight {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "spending_pattern" | "budget_alert" | "goal_progress" | "recommendation" | "anomaly"
  title       String
  description String   @db.Text
  severity    String   @default("info") // "info" | "warning" | "critical" | "success"
  category    String?  // Related category if applicable
  data        Json?    // Store chart data, calculations, etc.
  isRead      Boolean  @default(false)
  isArchived  Boolean  @default(false)
  validUntil  DateTime? // Insights can expire
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("insights")
}

// ============================================
// Transaction Templates
// ============================================

model TransactionTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  amount      Float?
  type        String   // "income" | "expense"
  category    String
  accountId   String?
  party       String?
  tags        String[] @default([])
  notes       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("transaction_templates")
}

// ============================================
// Settlements (for split expenses)
// ============================================

model Settlement {
  id        String   @id @default(cuid())
  userId    String
  party     String
  amount    Float
  type      String   // "owed_to_me" | "i_owe"
  reason    String?
  isSettled Boolean  @default(false)
  settledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("settlements")
}

model SettlementGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User                         @relation("SettlementGroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members      SettlementGroupMember[]
  invitations  SettlementGroupInvitation[]
  transactions SettlementGroupTransaction[]

  @@index([createdById])
  @@map("settlement_groups")
}

model SettlementGroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      String   @default("member") // "owner" | "member"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group SettlementGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("settlement_group_members")
}

model SettlementGroupInvitation {
  id            String   @id @default(cuid())
  groupId       String
  invitedById   String
  invitedUserId String
  invitedEmail  String
  status        String   @default("pending") // "pending" | "accepted" | "declined"
  createdAt     DateTime @default(now())
  respondedAt   DateTime?

  group      SettlementGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy  User            @relation("SettlementInvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser User           @relation("SettlementInvitationReceiver", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@unique([groupId, invitedUserId])
  @@index([invitedUserId, status])
  @@index([groupId])
  @@map("settlement_group_invitations")
}

model SettlementGroupTransaction {
  id          String   @id @default(cuid())
  groupId     String
  createdById String
  paidByUserId String
  description String
  totalAmount Float
  splitData   Json
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group     SettlementGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User            @relation("SettlementTransactionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  paidBy    User            @relation("SettlementTransactionPayer", fields: [paidByUserId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([paidByUserId])
  @@map("settlement_group_transactions")
}

// ============================================
// Receipts
// ============================================

model Receipt {
  id            String   @id @default(cuid())
  userId        String
  transactionId String?
  fileName      String
  fileUrl       String
  fileType      String?
  fileSize      Int?
  uploadedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionId])
  @@map("receipts")
}
