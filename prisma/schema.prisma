// Prisma Schema for Money Management App
// Database: PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Authentication Models (NextAuth)
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts            Account[]
  sessions            Session[]
  financialAccounts   FinancialAccount[]
  transactions        Transaction[]
  budgets             Budget[]
  categories          Category[]
  parties             Party[]
  goals               Goal[]
  watchlists          Watchlist[]
  recurringTransactions RecurringTransaction[]
  notifications       Notification[]
  chatMessages        ChatMessage[]
  saathiAuditLogs     SaathiAuditLog[]
  insights            Insight[]
  settings            UserSettings?
  templates           TransactionTemplate[]
  settlements         Settlement[]
  settlementGroupsCreated            SettlementGroup[]           @relation("SettlementGroupCreator")
  settlementGroupMemberships         SettlementGroupMember[]
  settlementGroupInvitationsSent     SettlementGroupInvitation[] @relation("SettlementInvitationSender")
  settlementGroupInvitationsReceived SettlementGroupInvitation[] @relation("SettlementInvitationReceiver")
  settlementGroupTransactionsCreated SettlementGroupTransaction[] @relation("SettlementTransactionCreator")
  settlementGroupTransactionsPaid    SettlementGroupTransaction[] @relation("SettlementTransactionPayer")
  settlementGroupMessagesSent        SettlementGroupMessage[]     @relation("GroupMessageSender")
  receipts            Receipt[]

  // Investments module
  familyMembers       FamilyMember[]
  investments         Investment[]
  insurancePolicies   InsurancePolicy[]
  devices             Device[]
  vehicles            Vehicle[]
  portfolioGroups     PortfolioGroup[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// User Settings
// ============================================

model UserSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  currency          String   @default("INR")
  currencySymbol    String   @default("₹")
  dateFormat        String   @default("MM/DD/YYYY")
  language          String   @default("en")
  darkMode          Boolean  @default(false)

  // Notifications
  notificationsEnabled          Boolean @default(true)
  budgetAlertsEnabled           Boolean @default(true)
  billRemindersEnabled          Boolean @default(true)
  goalMilestonesEnabled         Boolean @default(true)
  recurringTransactionsEnabled  Boolean @default(true)

  // Privacy
  requireAuth       Boolean  @default(false)
  autoLockMinutes   Int      @default(15)

  // Display
  showCents         Boolean  @default(true)
  compactMode       Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ============================================
// Financial Models
// ============================================

model FinancialAccount {
  id          String   @id @default(cuid())
  userId      String
  name        String
  balance     Float    @default(0)
  type        String   // "checking" | "savings" | "credit"
  color       String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  goals                 Goal[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
  @@map("financial_accounts")
}

model Transaction {
  id              String   @id @default(cuid())
  userId          String
  accountId       String
  description     String
  amount          Float
  date            DateTime
  category        String
  type            String   // "income" | "expense"
  party           String?
  notes           String?  @db.Text
  tags            String[] @default([])
  recurringId     String?
  isShared        Boolean  @default(false)
  splits          Json?
  totalAmount     Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account             FinancialAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@index([userId, date])       // main list query (sorted by date desc)
  @@index([userId, category])   // category filter
  @@index([userId, type])       // type filter
  @@index([userId, accountId])  // account filter
  @@index([accountId])          // FK lookups from FinancialAccount
  @@map("transactions")
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   // "income" | "expense" | "both"
  color     String?
  icon      String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subBudgets SubBudget[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Party {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("parties")
}

// ============================================
// Budgets
// ============================================

model Budget {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           String      // "monthly" | "event" | "trip"
  method         String      @default("envelope") // "envelope" | "fixed_cap" | "goal_linked"
  periodType     String      @default("monthly") // "monthly" | "custom" | "rolling"
  totalAllocated Float
  totalSpent     Float       @default(0)
  warningThreshold Float     @default(80)
  criticalThreshold Float    @default(100)
  alertWindowDays Int        @default(5)
  enforcementMode String     @default("soft") // "soft" | "hard"
  presetKey      String?
  goalId         String?
  startDate      DateTime?
  endDate        DateTime?
  rollover       Boolean     @default(false)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal       Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  subBudgets SubBudget[]

  @@index([userId, isActive])
  @@index([goalId])
  @@map("budgets")
}

model SubBudget {
  id             String   @id @default(cuid())
  budgetId       String
  categoryId     String?
  category       String
  allocated      Float
  spent          Float    @default(0)
  alertThreshold Float?   @default(80)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryRef Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([budgetId])
  @@index([categoryId])
  @@index([budgetId, category])
  @@map("sub_budgets")
}

// ============================================
// Goals
// ============================================

model Goal {
  id                   String   @id @default(cuid())
  userId               String
  name                 String
  targetAmount         Float
  currentAmount        Float    @default(0)
  targetDate           DateTime?
  monthlyContribution  Float?
  priority             String   @default("medium") // "low" | "medium" | "high"
  color                String?
  icon                 String?
  accountId            String?
  includeInSpendingPlan Boolean @default(true)
  notes                String?  @db.Text
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  linkedBudgets Budget[]

  @@index([userId])
  @@map("goals")
}

// ============================================
// Watchlists
// ============================================

model Watchlist {
  id             String    @id @default(cuid())
  userId         String
  name           String
  type           String    // "category" | "tag" | "payee"
  value          String
  budgetLimit    Float?
  period         String    @default("monthly") // "monthly" | "yearly" | "custom"
  startDate      DateTime?
  endDate        DateTime?
  alertEnabled   Boolean   @default(true)
  alertThreshold Float?    @default(80)
  color          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("watchlists")
}

// ============================================
// Recurring Transactions
// ============================================

model RecurringTransaction {
  id           String   @id @default(cuid())
  userId       String
  accountId    String
  description  String
  amount       Float
  category     String
  type         String   // "income" | "expense"
  frequency    String   // "daily" | "weekly" | "biweekly" | "monthly" | "quarterly" | "yearly"
  startDate    DateTime
  nextDueDate  DateTime
  isActive     Boolean  @default(true)
  autoCreate   Boolean  @default(false)
  reminderDays Int?     @default(3)
  notes        String?  @db.Text
  tags         String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([nextDueDate])
  @@map("recurring_transactions")
}

// ============================================
// Notifications
// ============================================

model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String   // "budget" | "bill" | "goal" | "recurring" | "info" | "warning"
  title      String
  message    String   @db.Text
  timestamp  DateTime @default(now())
  isRead     Boolean  @default(false)
  actionLink String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ============================================
// AI Chatbot & Insights
// ============================================

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   // "user" | "assistant"
  content   String   @db.Text
  metadata  Json?    // Store additional context like charts, insights referenced
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("chat_messages")
}

model SaathiAuditLog {
  id               String   @id @default(cuid())
  userId           String
  userMessageId    String?
  assistantMessageId String?
  tool             String
  operation        String
  resource         String
  status           String
  summary          String   @db.Text
  userRequest      String   @db.Text
  details          String[] @default([])
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, operation])
  @@map("saathi_audit_logs")
}

model Insight {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "spending_pattern" | "budget_alert" | "goal_progress" | "recommendation" | "anomaly"
  title       String
  description String   @db.Text
  severity    String   @default("info") // "info" | "warning" | "critical" | "success"
  category    String?  // Related category if applicable
  data        Json?    // Store chart data, calculations, etc.
  isRead      Boolean  @default(false)
  isArchived  Boolean  @default(false)
  validUntil  DateTime? // Insights can expire
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isArchived, isRead])
  @@index([userId, createdAt])
  @@map("insights")
}

// ============================================
// Transaction Templates
// ============================================

model TransactionTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  amount      Float?
  type        String   // "income" | "expense"
  category    String
  accountId   String?
  party       String?
  tags        String[] @default([])
  notes       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("transaction_templates")
}

// ============================================
// Settlements (for split expenses)
// ============================================

model Settlement {
  id        String   @id @default(cuid())
  userId    String
  party     String
  amount    Float
  type      String   // "owed_to_me" | "i_owe"
  reason    String?
  isSettled Boolean  @default(false)
  settledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("settlements")
}

model SettlementGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User                         @relation("SettlementGroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members      SettlementGroupMember[]
  invitations  SettlementGroupInvitation[]
  transactions SettlementGroupTransaction[]
  messages     SettlementGroupMessage[]

  @@index([createdById])
  @@map("settlement_groups")
}

model SettlementGroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      String   @default("member") // "owner" | "member"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group SettlementGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("settlement_group_members")
}

model SettlementGroupInvitation {
  id            String   @id @default(cuid())
  groupId       String
  invitedById   String
  invitedUserId String
  invitedEmail  String
  status        String   @default("pending") // "pending" | "accepted" | "declined"
  createdAt     DateTime @default(now())
  respondedAt   DateTime?

  group      SettlementGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy  User            @relation("SettlementInvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser User           @relation("SettlementInvitationReceiver", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@unique([groupId, invitedUserId])
  @@index([invitedUserId, status])
  @@index([groupId])
  @@map("settlement_group_invitations")
}

model SettlementGroupTransaction {
  id          String   @id @default(cuid())
  groupId     String
  createdById String
  paidByUserId String
  description String
  totalAmount Float
  splitData   Json
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group     SettlementGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User            @relation("SettlementTransactionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  paidBy    User            @relation("SettlementTransactionPayer", fields: [paidByUserId], references: [id], onDelete: Cascade)
  message   SettlementGroupMessage?

  @@index([groupId, createdAt])
  @@index([paidByUserId])
  @@map("settlement_group_transactions")
}

model SettlementGroupMessage {
  id            String   @id @default(cuid())
  groupId       String
  senderId      String
  type          String   // "text" | "expense" | "settlement" | "system" | "bill_analysis"
  content       String   @db.Text
  transactionId String?  @unique
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  group       SettlementGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender      User                        @relation("GroupMessageSender", fields: [senderId], references: [id])
  transaction SettlementGroupTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@index([senderId])
  @@map("settlement_group_messages")
}

// ============================================
// Receipts
// ============================================

model Receipt {
  id            String   @id @default(cuid())
  userId        String
  transactionId String?
  fileName      String
  fileUrl       String
  fileType      String?
  fileSize      Int?
  uploadedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionId])
  @@map("receipts")
}

// ============================================
// Investments Module – Family Members
// ============================================

model FamilyMember {
  id            String    @id @default(cuid())
  userId        String
  name          String
  relationship  String    // "self"|"spouse"|"father"|"mother"|"son"|"daughter"|"brother"|"sister"|"other"
  dateOfBirth   DateTime?
  gender        String?   // "male"|"female"|"other"
  bloodGroup    String?   // "A+"|"A-"|"B+"|"B-"|"AB+"|"AB-"|"O+"|"O-"
  phone         String?
  email         String?
  address       String?   @db.Text
  photo         String?   @db.Text
  employer      String?
  designation   String?
  annualIncome  Float?
  medicalNotes  String?   @db.Text
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityDocuments IdentityDocument[]
  investments       Investment[]
  insurancePolicies InsurancePolicy[]
  devices           Device[]
  vehicles          Vehicle[]

  @@index([userId])
  @@map("family_members")
}

model IdentityDocument {
  id               String    @id @default(cuid())
  memberId         String
  type             String    // "aadhaar"|"pan"|"passport"|"driving_license"|"voter_id"|"ration_card"|"other"
  documentNumber   String
  nameOnDocument   String?
  issueDate        DateTime?
  expiryDate       DateTime?
  issuingAuthority String?
  placeOfIssue     String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("identity_documents")
}

// ============================================
// Investments Module – Investments / Holdings
// ============================================

model Investment {
  id              String    @id @default(cuid())
  userId          String
  memberId        String
  name            String
  type            String    // "mutual_fund"|"fixed_deposit"|"ppf"|"epf"|"nps"|"stocks"|"gold"|"real_estate"|"bonds"|"rd"|"ssy"|"elss"|"nsc"|"kvp"|"scss"|"crypto"|"other"
  institution     String
  investedAmount  Float
  currentValue    Float
  startDate       DateTime
  maturityDate    DateTime?
  interestRate    Float?
  status          String    @default("active") // "active"|"matured"|"withdrawn"|"closed"

  // Mutual Fund fields
  folioNumber     String?
  sipAmount       Float?
  sipDay          Int?
  sipFrequency    String?   // "monthly"|"quarterly"
  fundCategory    String?   // "equity"|"debt"|"hybrid"|"elss"

  // Stock fields
  ticker          String?
  quantity        Float?
  buyPrice        Float?
  dematAccount    String?
  broker          String?

  // FD / RD / PPF fields
  accountNumber   String?
  compoundingFreq String?   // "monthly"|"quarterly"|"yearly"
  autoRenew       Boolean   @default(false)

  // NPS / EPF fields
  pranNumber      String?
  uanNumber       String?

  // Gold fields
  goldForm        String?   // "physical"|"digital"|"sgb"
  weightGrams     Float?
  purity          String?

  // Real Estate fields
  propertyAddress String?   @db.Text
  propertyArea    String?
  registrationNo  String?

  // Common
  nominee         String?
  taxSection      String?   // "80C"|"80CCC"|"80CCD"|"80D"|"10_14"|"none"
  portfolioGroup  String?
  tags            String[]  @default([])
  notes           String?   @db.Text
  color           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@index([userId, memberId])
  @@index([userId, status])
  @@map("investments")
}

// ============================================
// Investments Module – Insurance Policies
// ============================================

model InsurancePolicy {
  id               String    @id @default(cuid())
  userId           String
  memberId         String
  name             String
  type             String    // "term"|"endowment"|"ulip"|"money_back"|"whole_life"|"health"|"family_floater"|"super_topup"|"critical_illness"|"motor_comprehensive"|"motor_tp"|"home"|"travel"|"personal_accident"|"device_insurance"|"other"
  insurer          String
  policyNumber     String
  premiumAmount    Float
  premiumFrequency String    // "monthly"|"quarterly"|"half_yearly"|"yearly"|"single"
  sumAssured       Float
  startDate        DateTime
  endDate          DateTime?
  nextPremiumDate  DateTime?
  status           String    @default("active") // "active"|"lapsed"|"surrendered"|"matured"|"claimed"
  nominee          String?
  nomineeRelation  String?
  taxSection       String?   // "80C"|"80D"|"none"
  riders           String[]  @default([])
  coveredMembers   String[]  @default([])
  linkedVehicleId  String?
  linkedDeviceId   String?
  claimHistory     Json?
  agentName        String?
  agentPhone       String?
  tags             String[]  @default([])
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  member          FamilyMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  premiumPayments PremiumPayment[]

  @@index([userId])
  @@index([userId, type])
  @@index([userId, memberId])
  @@map("insurance_policies")
}

model PremiumPayment {
  id          String    @id @default(cuid())
  policyId    String
  amount      Float
  dueDate     DateTime
  paidDate    DateTime?
  status      String    @default("upcoming") // "upcoming"|"paid"|"overdue"|"skipped"
  paymentMode String?   // "bank_transfer"|"upi"|"cheque"|"cash"|"auto_debit"|"other"
  referenceNo String?
  notes       String?
  createdAt   DateTime  @default(now())

  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("premium_payments")
}

// ============================================
// Investments Module – Devices
// ============================================

model Device {
  id                String    @id @default(cuid())
  userId            String
  memberId          String
  name              String
  category          String    // "phone"|"laptop"|"tablet"|"desktop"|"tv"|"appliance"|"camera"|"wearable"|"audio"|"gaming"|"other"
  brand             String
  model             String
  serialNumber      String?
  imeiNumber        String?
  purchaseDate      DateTime?
  purchasePrice     Float?
  purchaseStore     String?
  warrantyEndDate   DateTime?
  extWarrantyEnd    DateTime?
  linkedInsuranceId String?
  status            String    @default("active") // "active"|"sold"|"damaged"|"lost"|"in_repair"|"retired"
  specs             Json?
  repairHistory     Json?
  tags              String[]  @default([])
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, memberId])
  @@map("devices")
}

// ============================================
// Investments Module – Vehicles
// ============================================

model Vehicle {
  id                String    @id @default(cuid())
  userId            String
  memberId          String
  name              String
  type              String    // "car"|"motorcycle"|"scooter"|"bicycle"|"auto"|"other"
  make              String
  vehicleModel      String
  variant           String?
  year              Int
  color             String?
  fuelType          String?   // "petrol"|"diesel"|"electric"|"hybrid"|"cng"
  registrationNo    String
  chassisNumber     String?
  engineNumber      String?
  purchaseDate      DateTime?
  purchasePrice     Float?
  showroomName      String?
  loanAmount        Float?
  emiAmount         Float?
  loanEndDate       DateTime?
  linkedInsuranceId String?
  pucExpiryDate     DateTime?
  fitnessExpiry     DateTime?
  status            String    @default("active") // "active"|"sold"|"scrapped"|"stolen"
  currentOdometer   Float?
  serviceHistory    Json?
  fuelLog           Json?
  tags              String[]  @default([])
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, memberId])
  @@map("vehicles")
}

// ============================================
// Investments Module – Portfolio Groups
// ============================================

model PortfolioGroup {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("portfolio_groups")
}
